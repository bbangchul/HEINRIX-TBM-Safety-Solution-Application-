# Environment
APP_ENV=dev
ADMIN_BASE_URL=https://admin-dev.heinrix.com

# Firebase project
FIREBASE_PROJECT_ID=heinrix-super-admin-dev
FIREBASE_FUNCTIONS_REGION=asia-northeast3
FIREBASE_HOSTING_SITE=heinrix-super-admin-dev
FIREBASE_HOSTING_TARGET=admin_dev

# Service accounts
FIREBASE_SERVICE_ACCOUNT_DEPLOYER=sa-super-admin-deployer@heinrix-super-admin-dev.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_RUNTIME=sa-super-admin-functions@heinrix-super-admin-dev.iam.gserviceaccount.com

# App Check
FIREBASE_APP_CHECK_WEB_RECAPTCHA_SITE_KEY=

# Auth policy
SUPER_ADMIN_ALLOWED_EMAIL_DOMAINS=heinrix.com
SUPER_ADMIN_ALLOWED_ENVIRONMENTS=dev

# Firebase web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Vite (web/.env)
VITE_APP_ENV=dev
VITE_ADMIN_BASE_URL=https://admin-dev.heinrix.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=heinrix-super-admin-dev
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-northeast3
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_SUPER_ADMIN_ALLOWED_DOMAINS=heinrix.com
VITE_SUPER_ADMIN_ALLOWED_ENVIRONMENTS=dev
